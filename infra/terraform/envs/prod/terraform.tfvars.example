# Copy to terraform.tfvars and fill in. terraform.tfvars itself is gitignored:
# it holds your project id and your home IP address, neither of which belongs in
# a public repository.
#
#   cp terraform.tfvars.example terraform.tfvars

project_id = "my-gcp-project-id"
region     = "asia-southeast1"

# REQUIRED. Without an entry here nothing can reach the private control plane
# and the cluster cannot be bootstrapped.
#
#   curl -s https://ifconfig.me
#
# Most home and office connections have a dynamic address, so expect to update
# this. If `kubectl` suddenly times out after working yesterday, this is why.
# 0.0.0.0/0 is rejected by a variable validation, not merely discouraged.
master_authorized_networks = [
  {
    cidr_block   = "203.0.113.7/32"
    display_name = "operator-laptop"
  },
]

# ── Optional overrides (defaults are sensible; shown for discoverability) ────

# cluster_name = "go-sample-app-prod"
# name_prefix  = "gsa-prod"

# Node sizing is driven by the LGTM stack, not the app. Dropping below
# e2-standard-4 means Task 6's observability pods will not schedule.
# machine_type       = "e2-standard-4"
# disk_type          = "pd-balanced"
# disk_size_gb       = 50
# min_nodes_per_zone = 1   # x3 zones = floor of 3 nodes
# max_nodes_per_zone = 3   # x3 zones = ceiling of 9 nodes

# Cost control. A regional cluster with 3 e2-standard-4 nodes runs roughly
# US$8-13/day, so tear it down between sessions. Teardown is two steps:
#
#   terraform apply -var deletion_protection=false
#   terraform destroy
#
# deletion_protection = true

# The app GSA holds no roles by default because the sample app calls no GCP API.
# Grant narrowly if that changes.
# app_roles = ["roles/secretmanager.secretAccessor"]
