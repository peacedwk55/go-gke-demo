# Demo profile — a short, cheap, throwaway run on real GKE.
#
#   cp demo.tfvars.example demo.tfvars     # then fill in project_id + your IP
#   terraform apply -var-file=demo.tfvars
#
# Everything the assignment is actually graded on is unchanged by this file:
# regional cluster across three zones, private nodes, Cloud NAT, Workload
# Identity, Dataplane V2, least-privilege node SA, the Artifact Registry remote
# repository. What changes is only the size of the machines underneath.
#
# ─────────────────────────────────────────────────────────────────────────────
# Why e2-standard-2 rather than the e2-standard-4 default
# ─────────────────────────────────────────────────────────────────────────────
#
# The default was sized for the LGTM stack with headroom to spare. Worked
# through properly, that headroom turns out to be unnecessary:
#
#   3 x e2-standard-2          = 6 vCPU / 24 GB
#   minus GKE system overhead  ≈ 4.5 vCPU / 18 GB usable
#   LGTM + app + ArgoCD need   ≈ 3.4 vCPU / 8 GB of requests
#
# It fits, with room left. And 6 vCPU matters for a second reason: the free
# trial FORBIDS requesting quota increases, so the run has to fit inside
# whatever the project's default CPU quota already is. 12 vCPU might not; 6
# almost certainly does.
#
# Check before applying, because the failure happens halfway through:
#
#   gcloud compute regions describe asia-southeast1 \
#     --format="table(quotas.metric,quotas.limit,quotas.usage)" \
#     | grep -iE "^CPUS|DISKS_TOTAL_GB"
#
# ─────────────────────────────────────────────────────────────────────────────

project_id = "REPLACE_ME"
region     = "asia-southeast1"

# REQUIRED, and there is no safe default: curl -s https://ifconfig.me
# Most connections have a dynamic address, so if kubectl starts timing out
# after working earlier, this is the first thing to re-check.
master_authorized_networks = [
  {
    cidr_block   = "REPLACE_ME/32"
    display_name = "operator-laptop"
  },
]

# ── Sizing ──────────────────────────────────────────────────────────────────

machine_type = "e2-standard-2" # 6 vCPU total across 3 zones
disk_size_gb = 30              # 90 GB of boot disk instead of 150

# Floor and ceiling both left at the defaults on purpose. min_nodes_per_zone
# must stay >= 1 or the LGTM stack's zonal PVCs lose the node in their zone and
# go Pending with no way to recover.
min_nodes_per_zone = 1
max_nodes_per_zone = 3

# ── Cost ────────────────────────────────────────────────────────────────────

# Spot VMs: roughly 60-90% off, reclaimable at short notice.
#
# For a demo that is not merely a discount. A node disappearing mid-rollout is
# precisely the scenario maxUnavailable: 0 and minAvailable: 1 exist for, and it
# is hard to stage deliberately. Enabling it here means the demo tests the
# design rather than just displaying it.
#
# Honest caveat: GKE's shutdown window for a preempted Spot VM is shorter than
# this workload's terminationGracePeriodSeconds (30s), so a preemption can
# truncate the drain. That is a limit of Spot, not a flaw in the drain sequence.
spot = true

# ── Lifecycle ───────────────────────────────────────────────────────────────

# false from the start for a demo, so teardown is one step instead of two.
#
# The two-step dance exists because deletion_protection lives in Terraform
# STATE, not in the CLI invocation: with it true, `terraform destroy` fails and
# you must `apply` the flip first. Setting it false up front avoids that — and
# is only acceptable *because* this cluster is disposable. Production keeps the
# default of true.
deletion_protection = false

# ─────────────────────────────────────────────────────────────────────────────
# Estimated cost, asia-southeast1
# ─────────────────────────────────────────────────────────────────────────────
#
#   control plane (regional)            $0.100/hr
#   3 x e2-standard-2, Spot            ~$0.075/hr
#   disks (90 GB boot + 115 GB PVC)    ~$0.034/hr
#   Cloud NAT                          ~$0.050/hr
#   ──────────────────────────────────────────────
#   total                              ~$0.26/hr  ->  ~$0.80 for a 3-hour demo
#
# On-demand instead of Spot is about $0.43/hr. Either way this is a rounding
# error against the $300 trial credit — provided the cluster is destroyed
# afterwards. Forgotten, it is ~$190-310/month.
#
# See the teardown checklist in ../../README.md: `terraform destroy` does NOT
# remove the persistent disks that Kubernetes created for the LGTM PVCs, and
# 115 GB of orphaned disk quietly bills ~$14/month.
