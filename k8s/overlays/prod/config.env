# Production tunables.
#
# This is the file a developer edits day to day. Kustomize turns it into a
# ConfigMap with a content hash in its name, the Deployment reference is
# rewritten to match, and the changed name triggers a rolling restart --
# so a config change ships through exactly the same reviewed, revertible
# GitOps path as a code change. No kubectl, no restart command, no drift.
#
# Every key here is read by app/config.go. An unparseable value fails the
# pod at startup with a clear message rather than silently falling back.

GREETING=Hello
LOG_LEVEL=info
MAX_NAME_LEN=64

# Ships spans to the Tempo distributor deployed by the observability stack.
# Clearing this value disables tracing entirely (see InitTracing) -- useful when
# running the same image outside the cluster.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo-distributor.observability.svc.cluster.local:4318

# Slowloris protection. Raise WRITE_TIMEOUT before adding any slow endpoint.
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# The drain sequence. SHUTDOWN_DELAY is the pause between "readiness starts
# failing" and "stop accepting connections"; it must stay comfortably below
# terminationGracePeriodSeconds (30s) together with SHUTDOWN_TIMEOUT.
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
