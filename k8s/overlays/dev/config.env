# Development tunables.
#
# Same keys as prod, different values -- which is the point: one image, one set
# of manifests, and the difference between environments lives entirely here.
GREETING=Hey there
LOG_LEVEL=debug
MAX_NAME_LEN=128

# Empty on purpose: tracing is disabled when no endpoint is set, so the dev
# overlay runs on a kind cluster with no LGTM stack present.
OTEL_EXPORTER_OTLP_ENDPOINT=

READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# SHUTDOWN_DELAY is 5s here, same as prod, and that is not an oversight.
#
# It was originally set to 1s so local rollouts would be quicker to watch. A
# rolling update under continuous load on a 2-node kind cluster then measured:
#
#   SHUTDOWN_DELAY=1s  ->  10486 requests,  15 failed  (0.14%, connection reset)
#   SHUTDOWN_DELAY=5s  ->   8017 requests,   0 failed
#
# One second is not enough for the EndpointSlice update to reach every node's
# kube-proxy, so traffic kept arriving at pods that had already closed their
# listener. Shortening it in dev would have made dev the one environment where
# the zero-downtime guarantee is quietly false -- exactly the class of bug this
# environment exists to catch.
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=10s
